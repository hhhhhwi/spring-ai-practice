# hwiai Environment Variables Template
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control!

# ===========================================
# Spring Configuration
# ===========================================
SPRING_PROFILES_ACTIVE=prod

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL username
DB_USERNAME=hwiai_user

# PostgreSQL password (CHANGE THIS!)
# Use strong password: mix of uppercase, lowercase, numbers, symbols
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ===========================================
# OpenAI Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=CHANGE_THIS_OPENAI_API_KEY

# OpenAI model (optional, default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-3.5-turbo, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# ===========================================
# JWT Configuration
# ===========================================
# JWT secret key (CHANGE THIS!)
# Generate a strong random string (minimum 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MIN_32_CHARS

# JWT expiration time in milliseconds (optional, default: 14 days)
# 1 day = 86400000, 7 days = 604800000, 14 days = 1209600000
JWT_EXPIRATION=1209600000

# ===========================================
# Example filled values (DO NOT USE IN PRODUCTION!)
# ===========================================
# SPRING_PROFILES_ACTIVE=prod
# DB_USERNAME=hwiai_user
# DB_PASSWORD=MyStr0ng!P@ssw0rd2024
# OPENAI_API_KEY=sk-proj-abc123def456ghi789...
# OPENAI_MODEL=gpt-4o-mini
# JWT_SECRET=my-super-secret-jwt-key-32-chars-min-2024-prod
# JWT_EXPIRATION=1209600000
